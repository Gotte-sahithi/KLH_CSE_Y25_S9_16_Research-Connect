public class RabinKarp {

    // Module 2: Rabin-Karp polynomial rolling hash.
    // Double hashing reduces collision probability.
    public static int search(String text, String pattern) {
        if (pattern.length() == 0) return 0;
        if (pattern.length() > text.length()) return -1;

        long mod1 = 1000000007L;
        long mod2 = 1000000009L;
        long base = 911382323L;

        int m = pattern.length();
        long hp1 = 0, hp2 = 0;
        long ht1 = 0, ht2 = 0;
        long power1 = 1, power2 = 1;

        for (int i = 0; i < m; i++) {
            hp1 = (hp1 * base + pattern.charAt(i)) % mod1;
            hp2 = (hp2 * base + pattern.charAt(i)) % mod2;

            ht1 = (ht1 * base + text.charAt(i)) % mod1;
            ht2 = (ht2 * base + text.charAt(i)) % mod2;

            if (i < m - 1) {
                power1 = (power1 * base) % mod1;
                power2 = (power2 * base) % mod2;
            }
        }

        for (int i = 0; i <= text.length() - m; i++) {
            if (hp1 == ht1 && hp2 == ht2 &&
                text.regionMatches(i, pattern, 0, m)) {
                return i;
            }

            if (i < text.length() - m) {
                ht1 = (ht1 - text.charAt(i) * power1) % mod1;
                if (ht1 < 0) ht1 += mod1;
                ht1 = (ht1 * base + text.charAt(i + m)) % mod1;

                ht2 = (ht2 - text.charAt(i) * power2) % mod2;
                if (ht2 < 0) ht2 += mod2;
                ht2 = (ht2 * base + text.charAt(i + m)) % mod2;
            }
        }
        return -1;
    }
}
